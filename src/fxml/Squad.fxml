<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="15" styleClass="main-menu" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fifa.controller.SquadController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    <Label fx:id="teamLabel" styleClass="title-label"/>
    <Label fx:id="opponentLabel" style="-fx-text-fill: white; -fx-font-size: 18px;"/>
    
    <HBox spacing="20" alignment="CENTER">
        <VBox spacing="5">
            <Label text="Starting XI" style="-fx-text-fill: #e94560; -fx-font-weight: bold;"/>
            <ListView fx:id="startersListView" prefHeight="300" prefWidth="250"/>
        </VBox>
        <VBox spacing="5">
            <Label text="Substitutes" style="-fx-text-fill: #e94560; -fx-font-weight: bold;"/>
            <ListView fx:id="subsListView" prefHeight="300" prefWidth="250"/>
        </VBox>
    </HBox>
    
    <HBox spacing="20" alignment="CENTER">
        <Button text="Back" onAction="#handleBack" styleClass="menu-btn"/>
        <Button text="Play Match" onAction="#handlePlayMatch" styleClass="menu-btn"/>
    </HBox>
</VBox>
