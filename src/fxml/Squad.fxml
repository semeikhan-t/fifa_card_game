<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.fifa.controller.SquadController" styleClass="main-menu-bg" prefHeight="768.0" prefWidth="1366.0">

    <!-- LAYER 1: Deep Stadium Background -->
    <ImageView fx:id="stadiumBg" fitWidth="1366.0" fitHeight="768.0" preserveRatio="false">
        <image>
            <Image url="@/images/stadium_bg.png" />
        </image>
        <effect>
            <ColorAdjust brightness="-0.5" contrast="0.2" saturation="-0.2" />
        </effect>
    </ImageView>

    <!-- LAYER 2: Moving Light Beams / Fog (Managed in Controller) -->
    <Pane fx:id="ambientFxPane" prefWidth="1366.0" prefHeight="768.0" mouseTransparent="true">
        <!-- Generated programmatically for AAA feel -->
    </Pane>

    <!-- LAYER 3: Pitch Surface overlay to give it a glowing tech feel -->
    <Region styleClass="pitch-glow" mouseTransparent="true"/>

    <!-- LAYER 4: The Main BorderPane containing the interactive UI -->
    <BorderPane>
        
        <!-- TOP NAVIGATION -->
        <top>
            <VBox spacing="15">
                <padding>
                    <Insets top="30" right="40" bottom="0" left="40"/>
                </padding>
                
                <HBox alignment="CENTER_LEFT" spacing="30">
                    <Label text="TEAM MANAGEMENT" styleClass="squad-title-primary" />
                    
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <Button text="CLOSE" onAction="#onBackClicked" styleClass="close-btn" />
                </HBox>
                
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Button text="Squad" styleClass="top-nav-btn, top-nav-btn-active" />
                    <Button text="Tactics" styleClass="top-nav-btn" disable="true" />
                    <Button text="Assignments" styleClass="top-nav-btn" disable="true" />
                </HBox>
                
                <Separator style="-fx-opacity: 0.1;" />
            </VBox>
        </top>
        
        <!-- CENTER: Pitch and Players -->
        <center>
            <StackPane>
                <padding>
                    <Insets top="20" right="40" bottom="20" left="40"/>
                </padding>
                
                <!-- The Pitch Area -->
                <Pane fx:id="pitchPane" prefWidth="1286" prefHeight="500">
                    <!-- Perspective Pitch Grid or Image -->
                    <ImageView fitWidth="1286" fitHeight="480" preserveRatio="false" layoutY="10">
                        <image>
                            <Image url="@/images/pitch.png" />
                        </image>
                        <effect>
                            <PerspectiveTransform ulx="200" uly="0" urx="1086" ury="0" lrx="1286" lry="480" llx="0" lly="480" />
                        </effect>
                    </ImageView>
                    
                    <!-- Player Slots (Containers for cards) -->
                    <!-- We scale it up slightly for the larger resolution -->
                    <AnchorPane fx:id="starterSlotsPane" prefWidth="1286" prefHeight="500">
                        <!-- Positions will be added dynamically -->
                    </AnchorPane>
                </Pane>
            </StackPane>
        </center>
        
        <!-- BOTTOM: Glassmorphism Bench Area -->
        <bottom>
            <VBox styleClass="bench-glass-container" spacing="15">
                <HBox alignment="CENTER_LEFT" spacing="30">
                    <Button text="BACK" onAction="#onBackClicked" styleClass="action-btn-back" />
                    <Label text="SUBSTITUTES" styleClass="status-label" />
                    <Label fx:id="startersCountLabel" text="SELECTED: 0/11" styleClass="status-label, text-neon" />
                    
                    <!-- Rating Circle Placeholder -->
                    <StackPane fx:id="ratingCircleContainer">
                        <Circle radius="20" fill="transparent" stroke="#00ff66" strokeWidth="3" opacity="0.3"/>
                        <Circle fx:id="ratingProgressRing" radius="20" fill="transparent" stroke="#00ff66" strokeWidth="3" strokeDashArray="120" strokeDashOffset="30"/>
                        <Label fx:id="teamRatingLabel" text="85" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 14px;"/>
                    </StackPane>

                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="playButton" text="READY" onAction="#onPlayClicked" styleClass="action-btn-ready" disable="true" />
                </HBox>
                
                <ScrollPane fitToHeight="true" minHeight="185" prefHeight="185" maxHeight="185" styleClass="custom-scroll-pane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                    <content>
                        <HBox fx:id="benchBox" spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: transparent;" minHeight="160" maxHeight="160">
                            <padding>
                                <Insets top="5" right="20" bottom="5" left="20"/>
                            </padding>
                        </HBox>
                    </content>
                </ScrollPane>
            </VBox>
        </bottom>
        
    </BorderPane>

    <!-- LAYER 5: Cinematic Vignette Overlay (Darkens edges) -->
    <Region styleClass="vignette-overlay" mouseTransparent="true" />
    
</StackPane>
