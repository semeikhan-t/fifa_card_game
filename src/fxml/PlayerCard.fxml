<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.paint.*?>

<!-- The outer container has the drop shadow and handles the hover scaling -->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.fifa.controller.PlayerCardController"
           styleClass="player-card-container" 
           prefWidth="100" prefHeight="145"
           fx:id="cardRoot">
    
    <!-- Outer Soft Shadow Layer (Rendered below the card) -->
    <Rectangle width="90" height="135" arcWidth="8" arcHeight="8" fill="black" opacity="0.4" translateY="8">
        <effect>
            <GaussianBlur radius="12" />
        </effect>
    </Rectangle>

    <!-- Main Card Body Layer -->
    <StackPane fx:id="cardBody" prefWidth="100" prefHeight="145">
        <!-- 1. Background Gradient -->
        <Rectangle fx:id="cardBg" width="100" height="145" arcWidth="15" arcHeight="15" styleClass="player-card-bg-gold" />
        
        <!-- 2. Metallic Reflection Layer (animated on hover) -->
        <Rectangle fx:id="reflectionOverlay" width="100" height="145" arcWidth="15" arcHeight="15" mouseTransparent="true">
            <fill>
                <LinearGradient startX="0" startY="0" endX="1" endY="1">
                    <stops>
                        <Stop offset="0.0" color="rgba(255,255,255,0.4)" />
                        <Stop offset="0.4" color="transparent" />
                        <Stop offset="0.6" color="transparent" />
                        <Stop offset="1.0" color="rgba(0,0,0,0.4)" />
                    </stops>
                </LinearGradient>
            </fill>
        </Rectangle>
        
        <!-- 3. Inner Shadow Layer for depth -->
        <Rectangle width="100" height="145" arcWidth="15" arcHeight="15" fill="transparent" mouseTransparent="true">
            <effect>
                <InnerShadow radius="8" color="rgba(0,0,0,0.5)" />
            </effect>
        </Rectangle>

        <!-- 4. Content Layer -->
        <VBox alignment="TOP_CENTER" spacing="2">
            <padding>
                <Insets top="10" right="5" bottom="5" left="5"/>
            </padding>
            
            <HBox alignment="TOP_CENTER" spacing="2">
                <!-- Left Column: Rating, Pos, Flag -->
                <VBox alignment="TOP_CENTER" spacing="-2">
                    <Label fx:id="ratingLabel" text="85" styleClass="player-card-rating" style="-fx-font-size: 20px;" />
                    <Label fx:id="posLabel" text="ST" styleClass="player-card-pos" style="-fx-font-size: 10px;" />
                    <Region prefHeight="3" />
                    <ImageView fx:id="flagImage" fitWidth="20" fitHeight="13" preserveRatio="true" />
                </VBox>
                
                <!-- Right Column: Player Photo with glow -->
                <StackPane>
                    <!-- Small bloom behind photo -->
                    <Circle radius="20" fill="#ffffff" opacity="0.1">
                        <effect>
                            <GaussianBlur radius="8" />
                        </effect>
                    </Circle>
                    <ImageView fx:id="playerImage" fitWidth="55" fitHeight="55" preserveRatio="true" />
                </StackPane>
            </HBox>
            
            <Region VBox.vgrow="ALWAYS" />
            
            <!-- Separator line -->
            <Rectangle width="80" height="1" fill="white" opacity="0.3" />
            
            <Label fx:id="nameLabel" text="PLAYER" styleClass="player-card-name" style="-fx-font-size: 11px;" />
        </VBox>
        
        <!-- 5. Selection Glow Overlay (Hidden by default, shown when selected) -->
        <Rectangle fx:id="selectionOutline" width="100" height="145" arcWidth="15" arcHeight="15" styleClass="card-selected-outline" visible="false" mouseTransparent="true" />

    </StackPane>
</StackPane>
