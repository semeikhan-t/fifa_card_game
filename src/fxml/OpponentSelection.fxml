<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fifa.controller.OpponentSelectionController"
           styleClass="country-selection-bg" prefHeight="1000.0" prefWidth="1600.0">
    <children>
        <!-- Background Overlay for depth -->
        <Pane style="-fx-background-color: radial-gradient(center 50% 50%, radius 70%, rgba(0, 255, 136, 0.05), transparent);" />

        <VBox alignment="TOP_CENTER" spacing="40.0">
            <padding>
                <Insets top="60" right="60" bottom="60" left="60"/>
            </padding>
            <children>
                <VBox alignment="CENTER" spacing="-5">
                    <Label text="CHOOSE YOUR" style="-fx-text-fill: rgba(255, 255, 255, 0.5); -fx-font-size: 24px; -fx-font-weight: bold; -fx-letter-spacing: 4px;"/>
                    <Label text="OPPONENT" styleClass="title-secondary">
                        <font>
                            <Font name="System Bold Italic" size="56.0" />
                        </font>
                    </Label>
                </VBox>

                <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
                    <TilePane fx:id="countriesPane" alignment="CENTER" hgap="30.0" vgap="30.0" prefColumns="6">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>
                    </TilePane>
                </ScrollPane>

                <HBox alignment="CENTER" spacing="40.0">
                    <Button text="BACK" onAction="#onBackClicked" styleClass="premium-nav-btn" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="nextButton" text="NEXT" onAction="#onNextClicked" styleClass="premium-nav-btn" disable="true" />
                </HBox>
            </children>
        </VBox>
    </children>
</StackPane>
