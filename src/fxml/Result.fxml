<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" styleClass="main-menu" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fifa.controller.ResultController">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
    <Label text="Match Finished!" styleClass="title-label"/>
    
    <HBox spacing="20" alignment="CENTER">
        <Button text="Play Again" onAction="#handlePlayAgain" styleClass="menu-btn"/>
        <Button text="Main Menu" onAction="#handleMenu" styleClass="menu-btn"/>
    </HBox>
</VBox>
