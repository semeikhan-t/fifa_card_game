<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20" styleClass="main-menu" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fifa.controller.MainMenuController">
    <padding><Insets top="50" right="50" bottom="50" left="50"/></padding>
    <Label text="FIFA Card Game 2026" styleClass="title-label"/>
    <Button text="Play" onAction="#handlePlay" styleClass="menu-btn"/>
    <Button text="Statistics" onAction="#handleStats" styleClass="menu-btn"/>
    <Button text="Exit" onAction="#handleExit" styleClass="menu-btn"/>
</VBox>
