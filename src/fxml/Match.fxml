<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15" styleClass="main-menu" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fifa.controller.MatchController">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
    
    <Label fx:id="teamsLabel" styleClass="title-label"/>
    <Label fx:id="scoreLabel" style="-fx-font-size: 48px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    <Label fx:id="timeLabel" style="-fx-font-size: 24px; -fx-text-fill: #e94560;"/>
    
    <ListView fx:id="eventsListView" prefHeight="300" prefWidth="400"/>
    
    <Button fx:id="finishBtn" text="View Results" onAction="#handleFinish" styleClass="menu-btn" visible="false"/>
</VBox>
