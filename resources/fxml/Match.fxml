<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="30.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.fifa.controller.MatchController" styleClass="main-menu-bg" prefHeight="600.0" prefWidth="800.0">
    <children>
        <HBox alignment="CENTER" spacing="50.0">
            <VBox alignment="CENTER">
                <Label fx:id="homeTeamLabel" text="HOME" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label fx:id="homeScoreLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 64; -fx-font-weight: bold;" />
            </VBox>
            <Label text="VS" style="-fx-text-fill: #d4af37; -fx-font-size: 32; -fx-font-weight: bold;" />
            <VBox alignment="CENTER">
                <Label fx:id="awayTeamLabel" text="AWAY" style="-fx-text-fill: white; -fx-font-size: 24; -fx-font-weight: bold;" />
                <Label fx:id="awayScoreLabel" text="0" style="-fx-text-fill: white; -fx-font-size: 64; -fx-font-weight: bold;" />
            </VBox>
        </HBox>
        
        <Label fx:id="timerLabel" text="0''" style="-fx-text-fill: #aaa; -fx-font-size: 24;" />
        
        <VBox fx:id="eventLog" alignment="CENTER" spacing="10" prefHeight="200" style="-fx-background-color: rgba(0,0,0,0.2); -fx-padding: 20;">
            <Label text="МАТЧ НАЧАЛСЯ!" style="-fx-text-fill: #00ff00;" />
        </VBox>
        
        <Button fx:id="resultButton" text="РЕЗУЛЬТАТЫ" onAction="#onResultClicked" styleClass="menu-button" visible="false" />
    </children>
</VBox>