<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.effect.DropShadow?>

<StackPane prefWidth="80" prefHeight="110" styleClass="player-card-container"
           xmlns="http://javafx.com/javafx/17" 
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fifa.controller.PlayerCardController">
    
    <!-- Фон карточки -->
    <Rectangle fx:id="cardBg" width="80" height="110" styleClass="player-card-bg" 
               arcWidth="4" arcHeight="4"/>
    
    <VBox spacing="0" alignment="TOP_CENTER" prefWidth="80" prefHeight="110">
        
        <!-- Рейтинг (top-right) -->
        <StackPane prefHeight="10" prefWidth="80">
            <Label fx:id="ratingLabel" text="89" 
                   styleClass="player-card-rating"
                   style="-fx-font-size: 12px; -fx-padding: 0 4 0 0;"
                   StackPane.alignment="TOP_RIGHT" />
        </StackPane>
        
        <!-- Фото игрока -->
        <ImageView fx:id="playerImage" fitWidth="70" fitHeight="70" 
                   preserveRatio="true" styleClass="player-card-image">
            <StackPane.margin>
                <Insets top="2" left="5" right="5"/>
            </StackPane.margin>
        </ImageView>
        
        <!-- Информация о игроке (внизу) -->
        <VBox spacing="0" alignment="CENTER" style="-fx-padding: 2;">
            <!-- Имя -->
            <Label fx:id="nameLabel" text="Player Name" 
                   styleClass="player-card-name"
                   style="-fx-font-size: 8; -fx-font-weight: bold;"/>
            
            <!-- Позиция -->
            <Label fx:id="posLabel" text="GK" 
                   styleClass="player-card-position"
                   style="-fx-font-size: 7; -fx-text-fill: #aaa;"/>
        </VBox>
        
        <!-- Флаг страны (bottom) -->
        <ImageView fx:id="flagImage" fitWidth="12" fitHeight="8" 
                   preserveRatio="true" style="-fx-padding: 1;"/>
        
    </VBox>
    
    <!-- Тень -->
    <effect>
        <DropShadow radius="4" offsetX="0" offsetY="2" color="#00000040"/>
    </effect>
    
</StackPane>
