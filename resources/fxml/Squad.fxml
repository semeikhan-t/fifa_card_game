<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.fifa.controller.SquadController" prefHeight="768.0" prefWidth="1366.0"
           style="-fx-background-color: #050a0f;">

    <!-- LAYER 1: Stadium Background -->
    <ImageView fitWidth="1366.0" fitHeight="768.0" preserveRatio="false">
        <image>
            <Image url="@/images/stadium_bg.png" />
        </image>
        <effect>
            <ColorAdjust brightness="-0.5" contrast="0.2" saturation="-0.2" />
        </effect>
    </ImageView>

    <!-- LAYER 2: Ambient FX Pane -->
    <Pane fx:id="ambientFxPane" prefWidth="1366.0" prefHeight="768.0" mouseTransparent="true" />

    <!-- LAYER 3: Pitch glow -->
    <Region styleClass="pitch-glow" mouseTransparent="true"/>

    <!-- LAYER 4: Main UI -->
    <BorderPane>

        <!-- TOP NAVIGATION: только заголовок + CLOSE -->
        <top>
            <VBox spacing="10">
                <padding>
                    <Insets top="20" right="40" bottom="0" left="40"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="30">
                    <Label text="TEAM MANAGEMENT" styleClass="squad-title-primary" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="CLOSE" onAction="#onBackClicked" styleClass="close-btn" />
                </HBox>

                <!-- Squad tab indicator (без Tactics и Assignments) -->
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Button text="Squad" styleClass="top-nav-btn, top-nav-btn-active" />
                </HBox>

                <Separator style="-fx-opacity: 0.1;" />
            </VBox>
        </top>

        <!-- CENTER: Pitch -->
        <center>
            <StackPane>
                <padding>
                    <Insets top="5" right="40" bottom="5" left="40"/>
                </padding>

                <Pane fx:id="pitchPane" prefWidth="1286" prefHeight="520">
                    <ImageView fitWidth="1286" fitHeight="500" preserveRatio="false" layoutY="10">
                        <image>
                            <Image url="@/images/pitch.png" />
                        </image>
                        <effect>
                            <PerspectiveTransform ulx="200" uly="0" urx="1086" ury="0" lrx="1286" lry="500" llx="0" lly="500" />
                        </effect>
                    </ImageView>

                    <AnchorPane fx:id="starterSlotsPane" prefWidth="1286" prefHeight="520" />
                </Pane>
            </StackPane>
        </center>
    </BorderPane>

    <!-- LAYER 5: Vignette -->
    <Region styleClass="vignette-overlay" mouseTransparent="true" />

    <!-- LAYER 6: Bench -->
    <VBox fx:id="benchDrawer" alignment="BOTTOM_CENTER" StackPane.alignment="BOTTOM_CENTER" pickOnBounds="false">

        <HBox alignment="CENTER" pickOnBounds="false">
            <Button fx:id="toggleBenchBtn" text="▼ SUBSTITUTES ▼" onAction="#onToggleBenchClicked"
                    styleClass="action-btn-back"
                    style="-fx-font-size: 12px; -fx-padding: 5 20; -fx-background-color: rgba(0,0,0,0.6);" />
        </HBox>

        <VBox fx:id="benchContainer" styleClass="bench-glass-container" spacing="15" minHeight="200" maxHeight="200">
            <HBox alignment="CENTER_LEFT" spacing="30">
                <Button text="BACK" onAction="#onBackClicked" styleClass="action-btn-back" />
                <Label text="SUBSTITUTES" styleClass="status-label" />
                <Label fx:id="startersCountLabel" text="SELECTED: 0/11" styleClass="status-label, text-neon" />

                <StackPane fx:id="ratingCircleContainer">
                    <Circle radius="20" fill="transparent" stroke="#00ff66" strokeWidth="3" opacity="0.3"/>
                    <Circle fx:id="ratingProgressRing" radius="20" fill="transparent" stroke="#00ff66" strokeWidth="3" strokeDashArray="120" strokeDashOffset="30"/>
                    <Label fx:id="teamRatingLabel" text="85" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 14px;"/>
                </StackPane>

                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="playButton" text="READY" onAction="#onPlayClicked" styleClass="action-btn-ready" disable="true" />
            </HBox>

            <ScrollPane fitToHeight="true" minHeight="145" prefHeight="145" maxHeight="145"
                        styleClass="custom-scroll-pane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                <content>
                    <HBox fx:id="benchBox" spacing="15" alignment="CENTER_LEFT"
                          style="-fx-background-color: transparent;" minHeight="125" maxHeight="125">
                        <padding>
                            <Insets top="5" right="20" bottom="5" left="20"/>
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>
    </VBox>
</StackPane>
