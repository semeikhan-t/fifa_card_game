<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.media.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="600.0" prefWidth="800.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.fifa.controller.MainMenuController">
    <children>
        <!-- Fallback background image -->
        <ImageView fx:id="fallbackImageView" fitHeight="600.0" fitWidth="800.0" preserveRatio="false">
            <image>
                <Image url="@/images/wc2026.png" />
            </image>
        </ImageView>

        <MediaView fx:id="backgroundMediaView" fitHeight="600.0" fitWidth="800.0" preserveRatio="false" />

        
        <!-- Cinematic gradient overlay -->
        <Region styleClass="cinematic-overlay" />
        
        <BorderPane>
            <left>
                <VBox alignment="CENTER_LEFT" spacing="30.0" styleClass="main-menu-container">
                    <padding>
                        <Insets left="80.0" />
                    </padding>
                    <children>
                        <VBox spacing="0.0">
                            <Label text="FIFA CARD GAME" styleClass="title-primary" />
                            <Label text="2026" styleClass="title-secondary" />
                            <Region prefHeight="40.0" />
                        </VBox>
                        
                        <VBox fx:id="menuItemsBox" spacing="15.0" styleClass="menu-items-box">
                            <children>
                                <Button text="PLAY" onAction="#onPlayClicked" styleClass="premium-menu-btn" />
                                <Button text="STATS" onAction="#onStatsClicked" styleClass="premium-menu-btn" />
                                <Region prefHeight="20.0" />
                                <Button text="EXIT" onAction="#onExitClicked" styleClass="premium-menu-btn-exit" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </left>
            <bottom>
                <HBox alignment="BOTTOM_RIGHT" spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Button fx:id="replayButton" text="REPLAY" onAction="#onReplayClicked" styleClass="replay-btn-small" visible="false" />
                        <Label text="v1.0.0 | CYBER-SPORT EDITION" styleClass="version-label" />
                    </children>
                </HBox>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
