<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.fifa.controller.OpponentSelectionController" styleClass="main-menu-bg" prefHeight="600.0" prefWidth="800.0">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <children>
        <Label text="ВЫБЕРИТЕ СОПЕРНИКА" styleClass="title-label" />
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <TilePane fx:id="countriesPane" alignment="CENTER" hgap="20.0" vgap="20.0" prefColumns="4" />
        </ScrollPane>
        <HBox alignment="CENTER" spacing="20.0">
            <Button text="НАЗАД" onAction="#onBackClicked" styleClass="menu-button-secondary" />
            <Button fx:id="nextButton" text="ПРОСМОТР СОСТАВА" onAction="#onNextClicked" styleClass="menu-button" disable="true" />
        </HBox>
    </children>
</VBox>
