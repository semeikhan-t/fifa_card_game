<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.effect.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.fifa.controller.OpponentSquadController" styleClass="main-menu-bg" prefHeight="700.0" prefWidth="1100.0">

    <!-- Background -->
    <ImageView fitWidth="1100.0" fitHeight="700.0" preserveRatio="false">
        <image>
            <Image url="@/images/stadium_bg.png" />
        </image>
        <effect>
            <ColorAdjust brightness="-0.3" contrast="0.1" />
        </effect>
    </ImageView>

    <!-- Vignette Overlay -->
    <Region styleClass="vignette-overlay" mouseTransparent="true" />
    
    <!-- Main BorderPane for layout -->
    <BorderPane>
        <top>
            <VBox spacing="12">
                <padding>
                    <Insets top="20" right="30" bottom="0" left="30"/>
                </padding>
                
                <HBox alignment="CENTER_LEFT" spacing="25">
                    <Label fx:id="teamNameLabel" text="OPPONENT SQUAD" styleClass="squad-title-primary" />
                    
                    <Region HBox.hgrow="ALWAYS" />
                    
                    <Button text="BACK" onAction="#onBackClicked" styleClass="close-btn" />
                </HBox>
                
                <Separator style="-fx-opacity: 0.1;" />
            </VBox>
        </top>
        
        <!-- CENTER: Pitch and Players -->
        <center>
            <StackPane>
                <padding>
                    <Insets top="15" right="30" bottom="15" left="30"/>
                </padding>
                
                <!-- The Pitch Area -->
                <Pane fx:id="pitchPane" prefWidth="1040" prefHeight="380">
                    <!-- Pitch Image -->
                    <ImageView fitWidth="1040" fitHeight="360" preserveRatio="false" layoutY="10">
                        <image>
                            <Image url="@/images/pitch.png" />
                        </image>
                        <effect>
                            <PerspectiveTransform ulx="150" uly="0" urx="890" ury="0" lrx="1040" lry="360" llx="0" lly="360" />
                        </effect>
                    </ImageView>
                    
                    <!-- Player Slots -->
                    <AnchorPane fx:id="starterSlotsPane" prefWidth="1040" prefHeight="380">
                        <!-- Positions will be added dynamically -->
                    </AnchorPane>
                </Pane>
            </StackPane>
        </center>
    </BorderPane>
    
    <!-- Slide-out Bench Overlay -->
    <VBox fx:id="benchDrawer" alignment="BOTTOM_CENTER" StackPane.alignment="BOTTOM_CENTER" pickOnBounds="false">
        
        <!-- Toggle Button Container -->
        <HBox alignment="CENTER" pickOnBounds="false">
            <Button fx:id="toggleBenchBtn" text="▼ SUBSTITUTES ▼" onAction="#onToggleBenchClicked" styleClass="action-btn-back" style="-fx-font-size: 11px; -fx-padding: 5 15; -fx-background-color: rgba(0,0,0,0.6);" />
        </HBox>

        <!-- Actual Bench Container -->
        <VBox fx:id="benchContainer" styleClass="bench-glass-container" spacing="12" minHeight="160" maxHeight="160">
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Button text="BACK" onAction="#onBackClicked" styleClass="action-btn-back" />
                <Label text="SUBSTITUTES" styleClass="status-label" />
                
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="startMatchButton" text="START MATCH" onAction="#onStartMatchClicked" styleClass="action-btn-ready" />
            </HBox>
            
            <ScrollPane fitToHeight="true" minHeight="115" prefHeight="115" maxHeight="115" styleClass="custom-scroll-pane" vbarPolicy="NEVER" hbarPolicy="AS_NEEDED">
                <content>
                    <HBox fx:id="benchBox" spacing="12" alignment="CENTER_LEFT" style="-fx-background-color: transparent;" minHeight="100" maxHeight="100">
                        <padding>
                            <Insets top="5" right="15" bottom="5" left="15"/>
                        </padding>
                    </HBox>
                </content>
            </ScrollPane>
        </VBox>
    </VBox>
</StackPane>