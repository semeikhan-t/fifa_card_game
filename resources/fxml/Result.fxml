<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.fifa.controller.ResultController" styleClass="main-menu-bg" prefHeight="600.0" prefWidth="800.0">
    <children>
        <Label text="РЕЗУЛЬТАТ МАТЧА" styleClass="title-label" />
        <Label fx:id="resultLabel" text="0 - 0" style="-fx-text-fill: white; -fx-font-size: 48; -fx-font-weight: bold;" />
        <ListView fx:id="eventsList" prefHeight="250" maxWidth="400" styleClass="dark-list-view" />
        <HBox alignment="CENTER" spacing="20.0">
            <Button text="В МЕНЮ" onAction="#onMenuClicked" styleClass="menu-button-secondary" />
            <Button text="СТАТИСТИКА" onAction="#onStatsClicked" styleClass="menu-button" />
        </HBox>
    </children>
</VBox>